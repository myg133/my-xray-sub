{
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check **/*.ts",
    "test": "deno test --allow-env --allow-net=localhost,127.0.0.1,vps789.com",
    "dev": "deno run --allow-env --allow-net --allow-read --watch main.ts"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  },
  "exclude": ["**/_fresh/*", "**/node_modules/*"]
}