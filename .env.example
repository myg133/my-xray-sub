# Required: long random string clients send as X-Sub-Token
SUB_TOKEN=

# Required: token from vps789.com user profile (openApi cfIpApi endpoint)
VPS789_TOKEN=

# Required: JWT (yf-token header) for vps789.com openApi cfIpTop20 endpoint
# Generate from browser devtools network tab on vps789.com while authenticated.
VPS789_YF_TOKEN=

# Optional overrides
MAX_NODES_IP=20
MAX_NODES_DOMAIN=20
SCORE_THRESHOLD=500
PKGLOST_THRESHOLD=10
KV_REFRESH_CRON=0 * * * *
PORT=8000
